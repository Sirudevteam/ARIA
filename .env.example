# =============================================================================
# LiDAR AI Assistant — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="LiDAR AI Assistant"
APP_VERSION="0.1.0"
APP_ENV=development                  # development | staging | production
DEBUG=true

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true                  # Hot reload (dev only)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── PostgreSQL (local Docker) ────────────────────────────────────────────────
POSTGRES_USER=lidar_user
POSTGRES_PASSWORD=lidar_password
POSTGRES_DB=lidar_db
POSTGRES_HOST=localhost              # Use "postgres" when running in Docker Compose
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lidar_user:lidar_password@localhost:5432/lidar_db

# ─── Supabase (cloud, optional) ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Frontend (Next.js public vars) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_APP_NAME="LiDAR AI Assistant"

# ─── Future: LLM (not implemented yet) ────────────────────────────────────────
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
