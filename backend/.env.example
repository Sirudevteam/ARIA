# ─────────────────────────────────────────────────────────────────────────────
# ARIA Backend — Environment Variables Configuration
# Copy this file to .env: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="ARIA"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Comma-separated list of allowed origins or *.railway.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.railway.app

# ── RELATIONAL DATABASE (PostgreSQL) ─────────────────────────────────────────
# Railway / Self-hosted / Neon / Postgres
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://aria_user:aria_password@localhost:5432/aria_db

# ── QDRANT VECTOR DATABASE ───────────────────────────────────────────────────
# Self-hosted Qdrant container or Qdrant Cloud cluster
VECTOR_DB_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aria_chunks

# ── OBJECT STORAGE (Cloudflare R2 / S3 / Local) ──────────────────────────────
STORAGE_BACKEND=local
# For Cloudflare R2:
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=aria-documents
# R2_PUBLIC_URL_PREFIX=https://pub-xxx.r2.dev

# ── DEEPSEEK LLM INFERENCE ───────────────────────────────────────────────────
# Sign up at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ── EMBEDDING & RERANKER (BGE-M3 1024d) ──────────────────────────────────────
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANKER_PROVIDER=bge_reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
