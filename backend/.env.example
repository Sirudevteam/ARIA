# ─────────────────────────────────────────────────────────────────────────────
# ARIA Backend — Environment Variables Configuration
# Copy this file to .env: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="ARIA"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── SUPABASE POSTGRESQL & PGVECTOR ───────────────────────────────────────────
# Format: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or for connection pooler: postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── SUPABASE AUTH & API KEYS ────────────────────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Found in: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_min_32_characters

# ── DEEPSEEK LLM INFERENCE ──────────────────────────────────────────────────
# Sign up at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ── EMBEDDING & RERANKER (BGE-M3 1024d) ─────────────────────────────────────
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANKER_PROVIDER=bge_reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
