# Backend — Local Dev Environment Variables
# Copy to .env for local development without Docker

APP_NAME="LiDAR AI Assistant"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL — local Docker container
DATABASE_URL=postgresql+asyncpg://lidar_user:lidar_password@localhost:5432/lidar_db
